classDiagram
    direction TB

    namespace EntryPoint {
        class Login {
            <<login.py>>
            +Tk root
            +StringVar var_email
            +StringVar var_pass
            +PhotoImage icon_title
            +__init__(root)
            +login()
            +open_dashboard(user_name, user_role)
        }
    }

    namespace DashboardLayer {
        class IMS {
            <<dashboard.py>>
            +Tk root
            +str user_name
            +str user_role
            +PhotoImage icon_title
            +PhotoImage icon_side
            +PhotoImage MenuLogo
            +Label lbl_employee
            +Label lbl_supplier
            +Label lbl_category
            +Label lbl_product
            +Label lbl_sales
            +Label lbl_clock
            +__init__(root, user_name, user_role)
            +logout()
            +employee()
            +supplier()
            +category()
            +product()
            +sales()
            +update_content()
        }
    }

