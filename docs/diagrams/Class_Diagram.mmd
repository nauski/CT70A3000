    namespace BillingSalesLayer {
        class Billing {
            <<billing.py — standalone>>
            +Tk root
            +list cart_list
            +int chk_print
            +PhotoImage icon_title
            +Label lbl_clock
            +StringVar var_search
            +StringVar var_cname
            +StringVar var_contact
            +StringVar var_cal_input
            +StringVar var_pid
            +StringVar var_pname
            +StringVar var_price
            +StringVar var_qty
            +StringVar var_stock
            +Treeview product_Table
            +Treeview CartTable
            +Text txt_bill_area
            +Label lbl_amnt
            +Label lbl_discount
            +Label lbl_net_pay
            +Label lbl_inStock
            +Label cartTitle
            +__init__(root)
            +get_input(num)
            +clear_cal()
            +perform_cal()
            +show()
            +search()
            +get_data(ev)
            +get_data_cart(ev)
            +add_update_cart()
            +bill_update()
            +show_cart()
            +generate_bill()
            +bill_top()
            +bill_middle()
            +bill_bottom()
            +clear_cart()
            +clear_all()
            +update_date_time()
            +print_bill()
        }

        class Sales {
            <<sales.py>>
            +Toplevel root
            +list bill_list
            +StringVar var_invoice
            +Listbox Sales_List
            +Text bill_area
            +__init__(root)
            +show()
            +get_data(ev)
            +search()
            +clear()
        }
    }

    namespace Infrastructure {
        class create_db {
            <<create_db.py — runs on import>>
            +create_db()$ creates tables if not exist
            +create_db()$ seeds default admin user
        }

        class get_db {
            <<db.py>>
            +str DB_PATH$
            +get_db()$ yields Connection, Cursor
        }

        class create_treeview {
            <<ui_helpers.py>>
            +create_treeview(parent, columns)$ Treeview
        }
    }

    Login --> IMS : authenticates, creates new Tk root
    IMS --> Login : logout destroys root, reopens Login

    IMS --> Employee : employee() opens Toplevel
    IMS --> Supplier : supplier() opens Toplevel
    IMS --> Category : category() opens Toplevel
    IMS --> Product : product() opens Toplevel
    IMS --> Sales : sales() opens Toplevel

    Login ..> get_db : authenticates via
    IMS ..> get_db : update_content()
    Employee ..> get_db : CRUD operations
    Supplier ..> get_db : CRUD operations
    Category ..> get_db : CRUD operations
    Product ..> get_db : CRUD operations
    Billing ..> get_db : reads products, updates qty

    Employee ..> create_treeview : builds EmployeeTable
    Supplier ..> create_treeview : builds SupplierTable
    Category ..> create_treeview : builds CategoryTable
    Product ..> create_treeview : builds ProductTable
    Billing ..> create_treeview : builds product_Table, CartTable

    create_db ..> get_db : creates tables via

    Billing --> BillDir : writes .txt invoices
    Sales --> BillDir : reads .txt invoices

    class BillDir {
        <<bill/ directory>>
        +txt files storing invoices
    }

    class ims_db {
        <<ims.db>>
        +employee table
        +supplier table
        +category table
        +product table
    }

    get_db --> ims_db : connects to
